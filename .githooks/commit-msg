#!/bin/sh
# Conventional Commits commit-msg hook
# Format: <type>(<scope>): <subject> OR <type>: <subject>
# Types: feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert

COMMIT_MSG_FILE="$1"
FIRST_LINE=$(head -n 1 "$COMMIT_MSG_FILE")

# Allow merge commits or fixup/squash commits
if echo "$FIRST_LINE" | grep -qE '^(Merge|Revert|fixup!|squash!)'; then
  exit 0
fi

# Regex for Conventional Commits
PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_./-]+\))?!?: .+$'

if ! echo "$FIRST_LINE" | grep -qE "$PATTERN"; then
  echo ""
  echo "❌ Error: Invalid commit message format."
  echo ""
  echo "Commit messages must follow the Conventional Commits specification:"
  echo "  <type>(<scope>): <subject>"
  echo "  <type>: <subject>"
  echo ""
  echo "Valid types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  echo ""
  echo "Examples:"
  echo "  feat(fonts): vendor local web fonts"
  echo "  chore(deps): update jsPDF to 4.2.1"
  echo "  docs: add contributing guide"
  echo ""
  echo "Your message was:"
  echo "  $FIRST_LINE"
  echo ""
  exit 1
fi

exit 0
